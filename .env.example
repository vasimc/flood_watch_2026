# Google Cloud project ID registered for Earth Engine (see README.md setup
# steps). Used by src/flood_watch/ingest_satellite_gee.py -- the primary
# satellite flood-extent source (Sentinel-1 SAR).
GEE_PROJECT_ID=

# NASA Earthdata bearer token (https://urs.earthdata.nasa.gov/ -> Profile -> Generate Token,
# or the LAADS DAAC "Generate Token" page at https://ladsweb.modaps.eosdis.nasa.gov/profile/#generate-token)
# Used by src/flood_watch/ingest_satellite.py -- kept as a documented but
# deprioritized alternative (see README.md), not required for GEE_PROJECT_ID above.
# Copy this file to .env and fill in your own value. Never commit .env.
NASA_EARTHDATA_TOKEN=
